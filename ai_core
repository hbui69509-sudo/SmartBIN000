# ai_core.py
from ultralytics import YOLO
import config

class SmartBinAI:
    def __init__(self, model_path="yolov8n.pt"):
        print("Đang khởi động AI YOLOv8...")
        try:
            self.model = YOLO(model_path)
        except Exception as e:
            print(f"LỖI TẢI YOLO: {e}")
            exit()
            
        print("YOLOv8 đã sẵn sàng!")

    def predict_trash(self, frame):
        """Quét ảnh và trả về (Loại_Rác, Độ_Tự_Tin, Tọa_Độ_Khung_Vuông)"""
        results = self.model.predict(frame, conf=0.4, verbose=False)
        
        for r in results:
            for box in r.boxes:
                cls_id = int(box.cls[0])
                yolo_name = self.model.names[cls_id]
                
                # YOLO tự động loại bỏ người
                if yolo_name == 'person':
                    continue
                
                if yolo_name in config.YOLO_TO_TRASH:
                    trash_type = config.YOLO_TO_TRASH[yolo_name]
                    confidence = round(float(box.conf[0]) * 100)
                    
                    x1, y1, x2, y2 = map(int, box.xyxy[0])
                    bbox = (x1, y1, x2, y2)
                    
                    return trash_type, confidence, bbox
                    
        return None, 0, None
