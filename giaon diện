# ui_manager.py
import cv2
import numpy as np
import config
from utils import write_vietnamese

class UIManager:
    def __init__(self):
        print("Đang kết xuất Giao diện UI...")
        self.static_canvas = np.full((720, 1280, 3), config.BG_COLOR, dtype=np.uint8)
        self._build_static_ui()

    def _build_static_ui(self):
        # Header
        cv2.rectangle(self.static_canvas, (0, 0), (1280, 60), config.HEADER_COLOR, -1) 
        self.static_canvas = write_vietnamese(self.static_canvas, "✨ SMARTBIN KIOSK - PTIT AI", (30, 14), text_color=(255, 255, 255), font_size=26)

        # Sidebar nền
        self.side_x, self.side_y, self.side_w, self.side_h = 900, 90, 350, 600
        cv2.rectangle(self.static_canvas, (self.side_x, self.side_y), (self.side_x + self.side_w, self.side_y + self.side_h), config.PANEL_COLOR, -1)
        self.static_canvas = write_vietnamese(self.static_canvas, "📊 THỐNG KÊ RÁC", (self.side_x + 25, self.side_y + 20), text_color=(255, 255, 255), font_size=24)
        cv2.line(self.static_canvas, (self.side_x + 25, self.side_y + 60), (self.side_x + self.side_w - 25, self.side_y + 60), (100, 100, 100), 1)

        # Danh sách rác
        y_pos = self.side_y + 80
        for key in config.INSTRUCTIONS.keys():
            name = config.INSTRUCTIONS[key]["name"]
            color = config.INSTRUCTIONS[key]["color"]
            cv2.rectangle(self.static_canvas, (self.side_x + 25, y_pos), (self.side_x + self.side_w - 25, y_pos + 45), config.CARD_COLOR, -1)
            cv2.rectangle(self.static_canvas, (self.side_x + 25, y_pos), (self.side_x + 30, y_pos + 45), color, -1)
            self.static_canvas = write_vietnamese(self.static_canvas, name, (self.side_x + 45, y_pos + 8), text_color=(220, 220, 220), font_size=20)
            y_pos += 55

        # Footer thống kê
        cv2.rectangle(self.static_canvas, (self.side_x + 25, self.side_y + self.side_h - 110), (self.side_x + self.side_w - 25, self.side_y + self.side_h - 40), (60, 60, 65), -1)
        self.static_canvas = write_vietnamese(self.static_canvas, "TỔNG CỘNG:", (self.side_x + 45, self.side_y + self.side_h - 90), text_color=(255, 255, 255), font_size=24)
        self.static_canvas = write_vietnamese(self.static_canvas, "Nhấn phím [Q] để Tắt và Lưu Báo cáo", (self.side_x + 35, self.side_y + self.side_h - 25), text_color=(150, 150, 150), font_size=16)

    def draw_main_screen(self, raw_frame, app_state, current_info, current_conf, thong_ke_rac, tong_rac):
        canvas = self.static_canvas.copy()
        
        cam_x, cam_y, cam_w, cam_h = 30, 90, 840, 600
        frame_resized = cv2.resize(raw_frame, (cam_w, cam_h))
        
        box_size = 400
        start_x = int(cam_w / 2 - box_size / 2)
        start_y = int(cam_h / 2 - box_size / 2)
        
        # Vẽ Camera & Trạng thái
        if app_state == "WAITING":
            cv2.rectangle(frame_resized, (start_x, start_y), (start_x + box_size, start_y + box_size), (0, 255, 0), 2)
            cv2.rectangle(frame_resized, (240, cam_h - 70), (600, cam_h - 20), (20, 20, 20), -1)
            cv2.rectangle(frame_resized, (240, cam_h - 70), (600, cam_h - 20), (0, 255, 0), 2)
            frame_resized = write_vietnamese(frame_resized, "🎯 ĐẶT RÁC VÀ NHẤN [SPACE]", (265, cam_h - 55), text_color=(0, 255, 0), font_size=20)
            
            status_text, status_color = "ĐANG CHỜ", (0, 255, 0)
            
        elif app_state == "SHOW_RESULT":
            dark_overlay = np.zeros_like(frame_resized, dtype=np.uint8)
            frame_resized = cv2.addWeighted(frame_resized, 0.4, dark_overlay, 0.6, 0)
            cv2.rectangle(frame_resized, (start_x, start_y), (start_x + box_size, start_y + box_size), current_info["color"], 4)
            
            card_w, card_h = 560, 130
            card_x, card_y = int(cam_w/2 - card_w/2), int(cam_h/2 - card_h/2)
            cv2.rectangle(frame_resized, (card_x, card_y), (card_x + card_w, card_y + card_h), (30, 30, 35), -1)
            cv2.rectangle(frame_resized, (card_x, card_y), (card_x + card_w, card_y + 5), current_info["color"], -1)
            frame_resized = write_vietnamese(frame_resized, f"♻️ {current_info['name']} ({current_conf}%)", (card_x + 30, card_y + 25), text_color=current_info["color"], font_size=30)
            frame_resized = write_vietnamese(frame_resized, f"Hướng dẫn: {current_info['action']}", (card_x + 30, card_y + 75), text_color=(200, 200, 200), font_size=24)
            
            status_text, status_color = "ĐÃ NHẬN DIỆN", (0, 255, 255)

        # Dán camera vào canvas
        canvas[cam_y:cam_y+cam_h, cam_x:cam_x+cam_w] = frame_resized
        cv2.rectangle(canvas, (cam_x, cam_y), (cam_x+cam_w, cam_y+cam_h), (80, 80, 80), 1)

        # Vẽ Trạng thái (Header)
        cv2.rectangle(canvas, (1080, 12), (1250, 48), (20, 100, 50), -1)
        canvas = write_vietnamese(canvas, status_text, (1095, 18), text_color=status_color, font_size=18)

        # Cập nhật số liệu Sidebar
        y_pos_dynamic = self.side_y + 80
        for key, value in thong_ke_rac.items():
            canvas = write_vietnamese(canvas, str(value), (self.side_x + self.side_w - 60, y_pos_dynamic + 8), text_color=(255, 255, 255), font_size=22)
            y_pos_dynamic += 55
        
        canvas = write_vietnamese(canvas, str(tong_rac), (self.side_x + self.side_w - 70, self.side_y + self.side_h - 95), text_color=(0, 255, 0), font_size=32)

        return canvas, start_x, start_y, box_size
